/* ── Comment & Footer ── */
.comment-section{margin-top:32px;padding-top:24px;border-top:1px solid var(--outline-variant)}
.comment-section:empty{display:none}
.site-footer{border-top:1px solid var(--outline-variant);padding:16px 24px;text-align:center;background:var(--surface-container-low)}
.footer-nav{display:flex;justify-content:center;gap:16px;flex-wrap:wrap;margin-bottom:8px}
