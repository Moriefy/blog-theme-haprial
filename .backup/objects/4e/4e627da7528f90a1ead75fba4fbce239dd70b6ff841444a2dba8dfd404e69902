/* Theme switch — prefer browser-native snapshot (GPU composited) via CSS View Transitions.
   Fallback selector below is scoped to colour-only props + a short tween and omits !important
   so it can't force expensive style recalc across the whole * tree. */
@keyframes vt-fade-out{from{opacity:1}to{opacity:0}}
@keyframes vt-fade-in{from{opacity:0}to{opacity:1}}
::view-transition-old(root){animation:vt-fade-out 180ms var(--motion-standard) both}
::view-transition-new(root){animation:vt-fade-in 180ms var(--motion-standard) both}
/* Fallback tween (only used when View Transitions unsupported): short, colour-only. */
.theme-transitioning *,.theme-transitioning *::before,.theme-transitioning *::after{transition:background-color var(--dur-fast) var(--motion-standard),color var(--dur-fast) var(--motion-standard),border-color var(--dur-fast) var(--motion-standard),fill var(--dur-fast) var(--motion-standard),stroke var(--dur-fast) var(--motion-standard)!important}
[data-theme="light"]{
  --primary:#3D5A6E;--on-primary:#fff;--primary-container:#D4DDE3;--on-primary-container:#1B2A33;
  --surface:#FFFFFF;--surface-container-lowest:#FFFFFF;--surface-container-low:#F8F9FA;
  --surface-container:#F2F3F5;--surface-container-high:#ECEDEF;--surface-container-highest:#E6E7E9;
  --on-surface:#1C1C1E;--on-surface-variant:#4A4D51;--outline:#75787C;--outline-variant:#D4D5D7;
  --cb-bg:#24282d;--cb-text:rgba(255,255,255,.87);--cb-line:rgba(255,255,255,.2);--cb-bar-bg:rgba(255,255,255,.04);--cb-bar-border:rgba(255,255,255,.06);--cb-scroll-thumb:rgba(255,255,255,.12);--cb-scroll-track:rgba(255,255,255,.02);--ripple:rgba(0,0,0,.08);
  --e1:0 1px 2px rgba(0,0,0,.05),0 1px 3px rgba(0,0,0,.03);
  --e2:0 2px 6px rgba(0,0,0,.07),0 1px 3px rgba(0,0,0,.04);
  --e3:0 4px 14px rgba(0,0,0,.09),0 2px 4px rgba(0,0,0,.05);
}
[data-theme="dark"]{
  --primary:#9AB0BF;--on-primary:#1B2A33;--primary-container:#354A54;--on-primary-container:#BFCDD5;
  --surface:#191B1D;--surface-container-lowest:#0C0D0F;--surface-container-low:#1E2022;
  --surface-container:#1E2022;--surface-container-high:#282A2D;--surface-container-highest:#333538;
  --on-surface:#E3E3E6;--on-surface-variant:#A0A3A8;--outline:#6B6F73;--outline-variant:#333739;
  --cb-bg:#24282d;--cb-text:rgba(255,255,255,.87);--cb-line:rgba(255,255,255,.2);--cb-bar-bg:rgba(255,255,255,.04);--cb-bar-border:rgba(255,255,255,.06);--cb-scroll-thumb:rgba(255,255,255,.12);--cb-scroll-track:rgba(255,255,255,.02);--ripple:rgba(255,255,255,.08);
  --e1:0 1px 3px rgba(0,0,0,.2),0 1px 2px rgba(0,0,0,.15);
  --e2:0 2px 6px rgba(0,0,0,.3),0 1px 3px rgba(0,0,0,.2);
  --e3:0 4px 14px rgba(0,0,0,.35),0 2px 4px rgba(0,0,0,.25);
}
:root{
  --shape-xs:4px;--shape-s:8px;--shape-m:12px;--shape-l:16px;--shape-xl:28px;--shape-full:9999px;
  /* Motion tokens — unified easing + duration across the whole UI (avoids
     scattered ad-hoc cubic-bezier / ease literals for consistent rhythm). */
  --motion-standard:cubic-bezier(.4,0,.2,1);       /* neutral, default */
  --motion-standard-decelerate:cubic-bezier(0,0,.2,1); /* fast-in slow-out (entrances) */
  --motion-emphasized:cubic-bezier(.2,0,0,1);      /* expressive, large elements */
  --motion-exit:cubic-bezier(.4,0,1,1);            /* accelerating exit */
  --ease-spring:cubic-bezier(.34,1.56,.64,1);      /* subtle overshoot for taps */
  --dur-fast:140ms;
  --dur-med:220ms;
  --dur-slow:320ms;
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}
body{font-family:'Noto Sans SC','PingFang SC',Georgia,serif;background:var(--surface);color:var(--on-surface);line-height:1.75;font-size:16px;overflow-x:hidden;display:flex;flex-direction:column;min-height:100vh}
body.locked{overflow:hidden}
@media(max-width:768px){body.locked{padding-right:0!important}}
a{color:var(--primary);text-decoration:none}
.skip-link{position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden}
.skip-link:focus{position:static;width:auto;height:auto;padding:8px 16px;background:var(--primary);color:var(--on-primary);z-index:9999;font-size:14px;border-radius:var(--shape-s)}
::selection{background:var(--primary-container);color:var(--on-primary-container)}
::-webkit-scrollbar{width:6px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:var(--outline-variant);border-radius:3px}
.spacer{flex:1}.container{max-width:860px;margin:0 auto;padding:0 24px}

/* ── Top Bar ── */
.top-app-bar{position:sticky;top:0;z-index:100;height:56px;display:flex;align-items:center;padding:0 8px 0 24px;background:var(--surface)}
.top-app-bar::after{content:'';position:absolute;inset:0;box-shadow:var(--e1);opacity:0;transition:opacity var(--dur-med) var(--motion-standard);pointer-events:none;z-index:-1}
.top-app-bar.elevated::after{opacity:1}
.logo{font-family:'Cormorant Garamond',Georgia,serif;font-size:20px;font-weight:300;letter-spacing:.12em;color:var(--on-surface);cursor:pointer;user-select:none;padding:4px 8px;border-radius:8px;flex-shrink:0}
.icon-btn{width:40px;height:40px;border-radius:var(--shape-full);border:none;background:none;color:var(--on-surface-variant);display:flex;align-items:center;justify-content:center;cursor:pointer;position:relative;overflow:hidden;transition:transform 200ms var(--motion-standard);flex-shrink:0}
.icon-btn:hover{background:var(--surface-container-high)}
.icon-btn:active{background:var(--surface-container-highest)}
.icon-btn svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.theme-wrap{position:relative;width:22px;height:22px}
.theme-ico{position:absolute;inset:0;transition:transform var(--dur-slow) var(--motion-emphasized),opacity var(--dur-med) var(--motion-standard)}
.theme-ico.off{transform:rotate(-90deg) scale(0);opacity:0}

/* ── Tabs ── */
.page-tabs{position:sticky;top:56px;z-index:99;background:var(--surface);display:flex;border-bottom:1px solid var(--outline-variant);overflow-x:auto;scrollbar-width:none}
.page-tabs::-webkit-scrollbar{display:none}
.tab{flex:1;min-width:0;padding:8px 12px;border:none;background:none;font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:13px;font-weight:400;color:var(--on-surface-variant);cursor:pointer;text-align:center;white-space:nowrap;transition:color var(--dur-med) var(--motion-standard);position:relative;overflow:hidden}
.tab:hover{color:var(--on-surface);background:var(--surface-container-low)}
.tab.active{color:var(--primary)}
.tab-bar{position:absolute;bottom:0;left:0;height:3px;background:var(--primary);border-radius:var(--shape-full) var(--shape-full) 0 0;pointer-events:none;will-change:transform;transition:transform var(--dur-slow) var(--motion-emphasized)}

/* ── Page Transitions ── */
.page{display:none;padding-bottom:40px;contain:content}.page.active{display:block;flex:1}
@keyframes slideInRight{from{opacity:0;transform:translateX(24px)}to{opacity:1;transform:translateX(0)}}
@keyframes slideInLeft{from{opacity:0;transform:translateX(-24px)}to{opacity:1;transform:translateX(0)}}
@keyframes slideOutLeft{from{opacity:1;transform:translateX(0)}to{opacity:0;transform:translateX(-16px)}}
@keyframes slideOutRight{from{opacity:1;transform:translateX(0)}to{opacity:0;transform:translateX(16px)}}
.page.slide-in-right{animation:slideInRight var(--dur-med) var(--motion-standard) both}
.page.slide-in-left{animation:slideInLeft var(--dur-med) var(--motion-standard) both}
.page.slide-out-left{animation:slideOutLeft var(--dur-fast) var(--motion-exit) both}
.page.slide-out-right{animation:slideOutRight var(--dur-fast) var(--motion-exit) both}

/* ── Hero ── */
@keyframes heroReveal{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
.hero{padding:40px 0 28px;min-height:160px}
.hero h1{font-family:'LXGW WenKai','Noto Serif SC','Songti SC','SimSun',serif;font-size:clamp(28px,5vw,40px);font-weight:300;color:var(--on-surface);letter-spacing:.06em;line-height:1.15;margin-bottom:10px;animation:heroReveal var(--dur-slow) var(--motion-standard) both}
.hero p{font-family:'LXGW WenKai','Noto Serif SC','Songti SC','SimSun',serif;font-size:15px;color:var(--on-surface-variant);line-height:1.75;max-width:480px;animation:heroReveal var(--dur-slow) var(--motion-standard) .04s both}
.page-hero{padding:32px 0 18px}
.page-hero h1{font-family:'LXGW WenKai','Noto Serif SC','Songti SC','SimSun',serif;font-size:clamp(26px,4vw,34px);font-weight:300;color:var(--on-surface);letter-spacing:.06em;margin-bottom:6px}
.page-hero p{font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:13px;color:var(--on-surface-variant)}

/* ── Filter Bar ── */
@keyframes filterBarIn{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:translateY(0)}}
@keyframes filterBarOut{from{opacity:1;transform:translateY(0)}to{opacity:0;transform:translateY(-8px)}}
.filter-bar{display:none;align-items:center;gap:8px;padding:10px 16px;background:var(--primary-container);color:var(--on-primary-container);border-radius:10px;font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:13px;margin-bottom:14px;box-shadow:var(--e1);opacity:0;transform:translateY(-8px)}
.filter-bar.on{display:flex;opacity:1;transform:translateY(0)}
.filter-bar.out{animation:filterBarOut var(--dur-fast) var(--motion-exit) forwards}
.filter-clear{margin-left:auto;padding:4px 12px;border-radius:var(--shape-full);border:none;background:rgba(0,0,0,.08);color:inherit;font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:12px;font-weight:400;cursor:pointer;position:relative;overflow:hidden}
[data-theme="dark"] .filter-clear{background:rgba(255,255,255,.08)}

/* ── Article Cards ── */
#articleList{scroll-margin-top:104px}
.article-list{padding-bottom:8px}
.card{padding:16px 20px;cursor:pointer;position:relative;overflow:hidden;opacity:0;transform:translateY(8px);contain:content}
@keyframes cardIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.card.show{opacity:1;transform:translateY(0);animation:cardIn var(--dur-med) var(--motion-standard-decelerate) backwards}
.card+.card{border-top:1px solid var(--outline-variant)}
.card:hover{background:var(--surface-container-low)}
.card:active{background:var(--surface-container-high);transition-duration:0s}
.card:hover .card-title{color:var(--primary);transition:color var(--dur-med) var(--motion-standard)}
.card-date{font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:12px;color:var(--outline);margin-bottom:3px;font-weight:400}
.card-title{font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:18px;font-weight:600;color:var(--on-surface);line-height:1.4;margin-bottom:5px;transition:color var(--dur-fast) var(--motion-standard)}
.card-excerpt{font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:14px;color:var(--on-surface-variant);line-height:1.75;margin-bottom:8px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.card-meta{display:flex;align-items:center;gap:10px}
.tag{font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:12px;font-weight:400;color:var(--on-primary-container);background:var(--primary-container);padding:2px 10px;border-radius:var(--shape-s);transition:background var(--dur-fast) var(--motion-standard);cursor:pointer}
.tag:hover{background:var(--surface-container-highest)}
.pin-badge{font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:11px;font-weight:600;color:var(--primary);margin-left:12px}
.reading-time{font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:12px;color:var(--outline)}

/* ── Pagination ── */
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.no-results{display:none;text-align:center;padding:40px 0;font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:14px;color:var(--outline)}
.no-results.show{display:block;animation:fadeIn var(--dur-slow) var(--motion-standard) both}
.pagination{display:flex;align-items:center;gap:2px;padding:8px 0 0;visibility:hidden;opacity:0;transition:opacity var(--dur-med) var(--motion-standard),visibility var(--dur-med) var(--motion-standard);overflow-x:auto;scrollbar-width:none;-ms-overflow-style:none;justify-content:center;-webkit-overflow-scrolling:touch}
.pagination::-webkit-scrollbar{display:none}
.pagination.show{visibility:visible;opacity:1}
.pg-btn{min-width:36px;height:36px;border-radius:var(--shape-full);border:none;background:none;color:var(--on-surface-variant);font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:13px;font-weight:400;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;transition:color var(--dur-med) var(--motion-standard),background var(--dur-med) var(--motion-standard);position:relative;overflow:hidden;padding:0 4px;flex-shrink:0}
.pg-btn:hover:not(:disabled){background:var(--surface-container-high);transform:scale(1.08)}
.pg-btn:active:not(:disabled){transition-duration:60ms}
.pg-btn.active{background:var(--primary-container);color:var(--on-primary-container);font-weight:600}
.pg-btn:disabled{opacity:.3;cursor:default;pointer-events:none}
.pg-btn svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}

/* ── Tags Grid ── */
@keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
.tags-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px}
.tag-card{padding:14px 18px;background:var(--surface-container-lowest);border-radius:var(--shape-m);border:1px solid var(--outline-variant);cursor:pointer;transition:transform 180ms var(--motion-standard);position:relative;overflow:hidden;opacity:0;contain:content}
#pageTags.active .tag-card{animation:fadeUp var(--dur-slow) var(--motion-standard) var(--sd,0ms) both}
.tag-card:hover{border-color:var(--primary);box-shadow:var(--e2);transform:translateY(-3px)}
.tag-card:active{transition-duration:60ms}
.tag-card-name{font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:14px;font-weight:400;color:var(--on-surface);margin-bottom:2px}
.tag-card-count{font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:12px;color:var(--outline)}

/* ── Categories Grid ── */
.cats-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px}
.cat-card{padding:20px 22px;background:var(--surface-container-lowest);border-radius:var(--shape-m);border:1px solid var(--outline-variant);cursor:pointer;transition:transform 180ms var(--motion-standard);position:relative;overflow:hidden;opacity:0}
#pageCategories.active .cat-card{animation:fadeUp var(--dur-slow) var(--motion-standard) var(--sd,0ms) both}
.cat-card:hover{border-color:var(--primary);box-shadow:var(--e2);transform:translateY(-3px)}
.cat-card:active{transition-duration:60ms}
.cat-dot{width:8px;height:8px;border-radius:50%;margin-bottom:10px}
.cat-name{font-family:'Cormorant Garamond',Georgia,serif;font-size:20px;font-weight:400;color:var(--on-surface);margin-bottom:5px}
.cat-desc{font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:13px;color:var(--on-surface-variant);line-height:1.6;margin-bottom:8px}
.cat-count{font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:12px;color:var(--outline)}

/* ── Archive ── */
.archive-timeline{padding-bottom:20px;padding-left:48px;position:relative}
.archive-timeline::before{content:'';position:absolute;left:18px;top:0;width:1px;height:100%;background:var(--outline-variant);transform:scaleY(0);transform-origin:top;transition:transform .8s var(--motion-standard)}
.archive-timeline.grow::before{transform:scaleY(1)}
.archive-year-group{margin-bottom:32px}
.archive-year-label{font-family:'Cormorant Garamond',Georgia,serif;font-size:clamp(32px,6vw,48px);font-weight:300;color:var(--on-surface);letter-spacing:.02em;padding:24px 0 16px 12px;line-height:1.1;border-bottom:1px solid var(--outline-variant);margin-bottom:12px;display:flex;align-items:baseline;gap:12px}
.archive-year-count{font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:13px;font-weight:400;color:var(--outline)}
@keyframes archiveReveal{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}
.archive-card{display:flex;align-items:center;gap:16px;padding:14px 16px;cursor:pointer;border-radius:var(--shape-m);opacity:0;position:relative;overflow:hidden;transition:transform 200ms var(--motion-standard);border:1px solid var(--outline-variant);margin-bottom:8px}
#pageArchive.active .archive-card{animation:fadeUp var(--dur-slow) var(--motion-standard) var(--arch-d,0ms) both}
.archive-card:hover{border-color:var(--primary);box-shadow:var(--e2);transform:translateY(-3px)}
.archive-card:active{transition-duration:60ms}
.archive-card-date{display:flex;flex-direction:column;align-items:center;min-width:48px;flex-shrink:0}
.archive-card-month{font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:10px;font-weight:600;color:var(--primary);letter-spacing:.06em;text-transform:uppercase;line-height:1}
.archive-card-day{font-family:'Cormorant Garamond',Georgia,serif;font-size:24px;font-weight:300;color:var(--on-surface);line-height:1.2}
.archive-card-body{flex:1;min-width:0}
.archive-card-title{font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:15px;font-weight:500;color:var(--on-surface);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;transition:color 150ms;line-height:1.4}
.archive-card:hover .archive-card-title{color:var(--primary)}
.archive-card-meta{display:flex;align-items:center;gap:8px;margin-top:4px}
.archive-card-tag{font-family:'JetBrains Mono','SF Mono',monospace;font-size:10px;font-weight:400;color:var(--primary);background:var(--primary-container);padding:2px 8px;border-radius:4px;letter-spacing:.04em}
.archive-card-rt{font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:12px;color:var(--outline)}

/* ── Friends Grid ── */
.fl-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px}
.fl-card{display:flex;align-items:center;gap:14px;padding:16px 20px;background:var(--surface-container-lowest);border-radius:var(--shape-m);border:1px solid var(--outline-variant);cursor:pointer;transition:transform 180ms var(--motion-standard);text-decoration:none;color:inherit;opacity:0;overflow:hidden}
#pageFriends.active .fl-card{animation:fadeUp var(--dur-slow) var(--motion-standard) var(--sd,0ms) both}
.fl-card:hover{border-color:var(--primary);box-shadow:var(--e2);transform:translateY(-3px)}
.fl-card:active{transform:scale(.97);transition-duration:60ms}
@media(max-width:768px){.fl-card{-webkit-tap-highlight-color:rgba(0,0,0,.06);transition:border-color 200ms}[data-theme="dark"] .fl-card{-webkit-tap-highlight-color:rgba(255,255,255,.08)}}
.fl-avatar{width:48px;height:48px;border-radius:50%;object-fit:cover;flex-shrink:0;background:var(--surface-container);border:1px solid var(--outline-variant)}
.fl-info{flex:1;min-width:0}
.fl-name{font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:15px;font-weight:600;color:var(--on-surface);margin-bottom:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.fl-desc{font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:13px;color:var(--on-surface-variant);line-height:1.6;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}

/* ── About ── */
.about-center{text-align:center;padding:40px 0 28px}
.about-mono{width:72px;height:72px;border-radius:36px;background:var(--primary-container);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;overflow:hidden}
.about-mono img{width:100%;height:100%;object-fit:cover}
[data-theme="dark"] .about-mono{background:#D4DDE3}
.about-center h1{font-family:'LXGW WenKai','Noto Serif SC','Songti SC','SimSun',serif;font-size:28px;font-weight:300;letter-spacing:.1em;color:var(--on-surface);margin-bottom:6px}
.about-tagline{font-family:'LXGW WenKai','Noto Serif SC','Songti SC','SimSun',serif;font-size:14px;color:var(--primary);margin-bottom:24px;line-height:1.7}
.about-bio{max-width:460px;margin:0 auto;text-align:left}
.about-bio p{font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:15px;line-height:1.85;color:var(--on-surface-variant);margin-bottom:12px}
.about-divider{width:36px;height:1px;background:var(--outline-variant);margin:24px auto}
.about-section-title{font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.12em;color:var(--outline);margin-bottom:14px}
.about-skill-list{display:flex;flex-wrap:wrap;justify-content:center;gap:8px}
.about-skill{font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:13px;font-weight:400;padding:4px 14px;border-radius:var(--shape-s);border:1px solid var(--outline-variant);color:var(--on-surface-variant);background:var(--surface-container-lowest);transition:border-color 200ms;cursor:default;position:relative;overflow:hidden}
.about-skill:hover{border-color:var(--primary);color:var(--primary)}
.about-stats{display:flex;justify-content:center;gap:36px}
.about-stat{text-align:center}
.about-stat-num{display:block;font-family:'Cormorant Garamond',Georgia,serif;font-size:28px;font-weight:300;color:var(--on-surface);line-height:1.2}
.about-stat-label{font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:12px;color:var(--outline)}
