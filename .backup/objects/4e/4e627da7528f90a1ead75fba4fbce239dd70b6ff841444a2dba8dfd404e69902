/* ── Reduced Motion ── */
@media(prefers-reduced-motion:reduce){
  .ripple,.card,.tag-card,.cat-card,.fl-card,.archive-card,.sv-item,.page.slide-in-right,.page.slide-in-left,.hero h1,.hero p,.filter-bar.on,.no-results.show,.skel-line::after{animation:none!important}
  .si,.article-body>*,.toc,.toc-drawer,.toc-scrim,.search-view,.article-view,.fab,.fab-comment,.tab-bar,.rprog,.card,.tag-card,.cat-card,.fl-card,.archive-card,.icon-btn,.art-nav-btn,.pg-btn,.sv-item,.footer-link,.about-link{transition:none!important}
  .lightbox-img,.lightbox{transition:none!important}
}

/* ── Responsive ── */
@media(max-width:1200px){.toc{display:none}.toc-toggle{display:flex}}
@media(max-width:768px){
  .page.slide-in-right,.page.slide-in-left,.page.slide-out-left,.page.slide-out-right{animation:none!important}
  .card.show{animation:none!important;opacity:1;transform:none}
  .mermaid-block svg,.mermaid-block svg text{-webkit-user-select:text;user-select:text;touch-action:auto}
  .mermaid-block.zoomed svg{touch-action:none}
  .mermaid-block svg text::selection{background:var(--primary-container);color:var(--on-primary-container)}
  .mermaid-block svg text::-moz-selection{background:var(--primary-container);color:var(--on-primary-container)}
  .mermaid-block:not(.zoomed){-webkit-user-select:text;user-select:text}
  .top-app-bar{padding:0 4px 0 16px}.page-tabs .tab{padding:14px 10px;font-size:12px}
  .container{padding:0 16px}
  .av-content{padding:0 16px 120px}
  .page{padding-bottom:16px}
  .hero{padding:28px 0 20px}.hero h1{font-size:30px}
  .page-hero{padding:24px 0 14px}.page-hero h1{font-size:26px}
  .card{padding:14px 16px}.card-title{font-size:16px}.card-excerpt{font-size:13px}
  .article-header h1{font-size:24px}
  .article-body h2{font-size:20px;margin-top:32px}.article-body h3{font-size:16px}
  .art-nav{gap:8px}.art-nav-btn{padding:14px 12px;min-height:60px;gap:10px}
  .art-nav-title{font-size:13px;-webkit-line-clamp:1}.art-nav-icon{width:32px;height:32px}
  .art-nav-icon svg{width:16px;height:16px}
  .archive-timeline{padding-left:44px}.archive-timeline::before{left:14px}
  .archive-year-label{padding:32px 0 6px 12px}
  .cb-lines{padding:14px 12px 14px 8px}.cb-lines span{font-size:12px;line-height:1.6}
  .cb-pre-wrap pre[class*="language-"]{padding:14px 14px!important;font-size:12px!important;line-height:1.6!important}
  .cb-pre-wrap code[class*="language-"]{font-size:12px!important;line-height:1.6!important}
  .fab{bottom:20px;right:20px;width:48px;height:48px;border-radius:14px}
  .sv-input{font-size:16px}.tags-grid{grid-template-columns:repeat(auto-fill,minmax(150px,1fr))}
  .cats-grid{grid-template-columns:1fr}
  .fl-grid{grid-template-columns:1fr;gap:10px}
  .fl-card{padding:14px 16px;gap:12px}
  .fl-avatar{width:40px;height:40px}
  .filter-bar{margin-top:8px}
  #pageArticles .hero{display:none}
}
@media(max-width:480px){
  .hero{padding:24px 0 16px}.hero h1{font-size:26px}
  .card-title{font-size:15px}.article-header h1{font-size:22px}
  .article-body h2{font-size:18px}
  .art-nav{gap:6px}.art-nav-btn{padding:12px 10px;min-height:54px;gap:8px}
  .art-nav-title{font-size:12px}.art-nav-label{font-size:10px}
  .cb-lines{padding:12px 8px 12px 6px}.cb-lines span{font-size:11px;line-height:1.55}
  .cb-pre-wrap pre[class*="language-"]{padding:12px 12px!important;font-size:11px!important;line-height:1.55!important}
  .cb-pre-wrap code[class*="language-"]{font-size:11px!important;line-height:1.55!important}
  .tags-grid{grid-template-columns:repeat(2,1fr);gap:8px}
}

/* ── Print ── */
@media print{
  .top-app-bar,.page-tabs,.fab,.site-footer,.toc,.toc-sheet,.search-view,.art-nav,.rprog,.toc-toggle{display:none!important}
  .article-view{position:static!important;transform:none!important;overflow:visible!important}
  .article-body>*{opacity:1!important;transform:none!important}
  .si{opacity:1!important;transform:none!important}
  body{background:#fff!important;color:#000!important}
  a{color:#000!important;text-decoration:underline!important}
  .code-block{break-inside:avoid}
}

/* ── Focus ── */
:focus-visible{outline:2px solid var(--primary);outline-offset:2px}
.icon-btn:focus-visible,.fab:focus-visible,.tab:focus-visible,.pg-btn:focus-visible,.filter-clear:focus-visible,.art-nav-btn:focus-visible{outline:2px solid var(--primary);outline-offset:2px;border-radius:inherit}
.card:focus-visible,.tag-card:focus-visible,.cat-card:focus-visible,.fl-card:focus-visible,.archive-card:focus-visible,.about-link:focus-visible{outline:2px solid var(--primary);outline-offset:2px}
.toc-item:focus-visible,.toc-drawer-item:focus-visible,.sv-item:focus-visible,.footer-link:focus-visible{outline:2px solid var(--primary);outline-offset:2px}
:focus:not(:focus-visible){outline:none}

/* Task list */
.task-item{list-style:none;position:relative;padding-left:6px}
.task-item input[type="checkbox"]{margin-right:8px;accent-color:var(--primary);vertical-align:middle}
.task-item.checked{color:var(--on-surface-variant);text-decoration:line-through;opacity:.7}
.task-item.checked code{text-decoration:none}

/* Inline math */
.math-inline{font-style:italic;color:var(--on-surface-variant)}
.math-block{overflow-x:auto;padding:12px 0;font-style:italic;color:var(--on-surface-variant)}

/* ── Lightbox (Material Design 3) ── */
.lightbox{visibility:hidden;opacity:0;position:fixed;inset:0;z-index:999;display:flex;align-items:center;justify-content:center;transition:visibility .25s,opacity .25s var(--motion-standard)}
.lightbox.open{visibility:visible;opacity:1}
.lightbox-scrim{position:absolute;inset:0;background:rgba(12,14,16,.96);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);z-index:0}
/* — Central glass card holding the image + caption — */
.lb-panel{position:relative;z-index:10;display:flex;flex-direction:column;align-items:center;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:var(--shape-l);backdrop-filter:blur(14px) saturate(1.2);-webkit-backdrop-filter:blur(14px) saturate(1.2);box-shadow:0 8px 32px rgba(0,0,0,.4),0 24px 80px rgba(0,0,0,.45);padding:12px}
.lightbox-toolbar{position:absolute;top:12px;left:12px;right:12px;height:56px;display:flex;align-items:center;padding:0 8px 0 16px;z-index:30;pointer-events:none;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:var(--shape-xl);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);box-shadow:var(--e2)}
.lightbox-toolbar>*{pointer-events:auto}
.lightbox-counter{font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:13px;font-weight:600;color:rgba(255,255,255,.9);letter-spacing:.03em;padding:0 4px}
.lightbox-close{width:40px;height:40px;border-radius:var(--shape-full);border:none;background:transparent;color:rgba(255,255,255,.9);cursor:pointer;display:flex;align-items:center;justify-content:center;margin-left:auto;flex-shrink:0;transition:background .2s var(--motion-standard);overflow:hidden}
.lightbox-close:hover{background:rgba(255,255,255,.12)}
.lightbox-close:active{background:rgba(255,255,255,.18);transition-duration:60ms}
.lightbox-close svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.lightbox-stage{position:relative;z-index:10;display:flex;align-items:center;justify-content:center;width:100%;height:100%}
.lightbox-img-wrap{position:relative;cursor:zoom-in;user-select:none;-webkit-user-select:none;touch-action:none}
.lightbox-img-wrap.zoomed{cursor:grab}
.lightbox-img-wrap.zoomed.panning{cursor:grabbing}
.lightbox-img-wrap .lb-spinner{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:38px;height:38px;border:3px solid rgba(255,255,255,.2);border-top-color:rgba(255,255,255,.9);border-radius:50%;animation:lbSpin .8s cubic-bezier(.4,0,.2,1) infinite;z-index:5}
@keyframes lbSpin{to{transform:translate(-50%,-50%) rotate(360deg)}}
.lightbox-img.loading{visibility:hidden}
.lightbox-img{display:block;max-width:calc(100vw - 128px);max-height:calc(100vh - 160px);width:auto;height:auto;object-fit:contain;border-radius:var(--shape-m);background:#0b0d0f;transition:transform .22s var(--motion-standard-decelerate),opacity .18s;will-change:transform;contain:layout paint}
.lightbox-img.lb-closing{transition:transform .25s var(--motion-standard),opacity .25s var(--motion-standard);box-shadow:none}
.lightbox-nav{position:absolute;top:50%;transform:translateY(-50%);width:46px;height:46px;border-radius:var(--shape-full);border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.08);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);color:rgba(255,255,255,.85);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .2s var(--motion-standard),color .2s,box-shadow .2s;z-index:20;flex-shrink:0;box-shadow:var(--e1)}
.lightbox-nav:hover{background:rgba(255,255,255,.16);color:#fff;box-shadow:var(--e2)}
.lightbox-nav:active{background:rgba(255,255,255,.22);transition-duration:60ms}
.lightbox-nav svg{width:24px;height:24px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.lightbox-prev{left:16px}.lightbox-next{right:16px}
/* — MD3 bottom action bar: frosted pill, capsule counter chip, tonal buttons — */
.lightbox-bottombar{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);height:52px;display:flex;align-items:center;padding:0 8px;z-index:30;pointer-events:none;gap:4px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);border-radius:var(--shape-xl);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);box-shadow:var(--e2)}
.lightbox-bottombar>*{pointer-events:auto}
.lightbox-btn{width:40px;height:40px;border-radius:var(--shape-full);border:none;background:rgba(255,255,255,.06);color:rgba(255,255,255,.85);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .2s var(--motion-standard),color .2s,transform .12s;overflow:hidden;flex-shrink:0}
.lightbox-btn:hover{background:var(--primary-container);color:var(--on-primary-container)}
.lightbox-btn:active{background:color-mix(in srgb,var(--primary-container) 70%,white);transform:scale(.92);transition-duration:60ms}
.lightbox-btn svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.lightbox-bottombar .spacer{width:8px;flex:none}
/* — Caption: independently styled pill, fully resolved from glass card, no washout — */
.lb-caption{position:absolute;left:50%;transform:translateX(-50%);bottom:78px;z-index:35;pointer-events:none;display:none;max-width:min(80vw,560px);text-align:center;padding:10px 20px;font-size:14px;line-height:1.55;color:rgba(255,255,255,.96);background:rgba(24,26,28,.72);border:1px solid rgba(255,255,255,.12);border-radius:var(--shape-xl);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);box-shadow:var(--e1);font-family:'Noto Sans SC','PingFang SC',sans-serif;word-break:break-word}
.lb-caption:empty{display:none!important}
@media(max-width:640px){.lb-caption{bottom:74px;font-size:13px;padding:8px 16px;max-width:86vw}}
.zoom-indicator{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) scale(.8);background:rgba(24,26,28,.78);border:1px solid rgba(255,255,255,.14);color:#fff;font-family:'JetBrains Mono','SF Mono',monospace;font-size:16px;font-weight:600;padding:8px 18px;border-radius:var(--shape-full);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);box-shadow:var(--e2);opacity:0;pointer-events:none;z-index:50;transition:opacity .2s,transform .2s}
.zoom-indicator.show{opacity:1;transform:translate(-50%,-50%) scale(1)}
@keyframes fbSlideOutL{from{opacity:1;transform:translateX(0)}to{opacity:0;transform:translateX(-25%)}}
@keyframes fbSlideOutR{from{opacity:1;transform:translateX(0)}to{opacity:0;transform:translateX(25%)}}
@keyframes fbSlideInR{from{opacity:0;transform:translateX(25%)}to{opacity:1;transform:translateX(0)}}
@keyframes fbSlideInL{from{opacity:0;transform:translateX(-25%)}to{opacity:1;transform:translateX(0)}}
@keyframes lbEnterAnim{from{opacity:0;transform:scale(.92)}to{opacity:1;transform:scale(1)}}
[data-theme="dark"] .article-body img{filter:brightness(.85) contrast(1.05)}
[data-theme="dark"] .img-figure img{mix-blend-mode:luminosity}
[data-theme="dark"] .lightbox-toolbar{background:rgba(30,34,38,.55);border-color:rgba(255,255,255,.08);opacity:1}
[data-theme="dark"] .lightbox-bottombar{background:rgba(30,34,38,.6);border-color:rgba(255,255,255,.08);opacity:1}
[data-theme="dark"] .lb-panel{background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.08);box-shadow:0 8px 32px rgba(0,0,0,.5),0 24px 80px rgba(0,0,0,.55)}
[data-theme="dark"] .lightbox-close{color:rgba(255,255,255,.87)}
[data-theme="dark"] .lightbox-close:hover{background:rgba(255,255,255,.1)}
[data-theme="dark"] .lightbox-counter{color:rgba(255,255,255,.7)}
[data-theme="dark"] .lightbox-btn{color:rgba(255,255,255,.75)}
[data-theme="dark"] .lightbox-btn:hover{background:rgba(255,255,255,.1);color:rgba(255,255,255,.95)}
[data-theme="dark"] .lightbox-nav{background:rgba(255,255,255,.08);color:rgba(255,255,255,.65);opacity:1}
[data-theme="dark"] .lightbox-nav:hover{background:rgba(255,255,255,.15);color:rgba(255,255,255,.95)}
[data-theme="dark"] .lightbox-nav:active{background:rgba(255,255,255,.2)}
@media(max-width:768px){
.lightbox-img{max-width:calc(100vw - 80px);max-height:calc(100vh - 56px);width:auto;height:auto;object-fit:contain}
.lightbox-nav{width:40px;height:40px}.lightbox-nav svg{width:20px;height:20px}
.lightbox-prev{left:4px}.lightbox-next{right:4px}
.lightbox-close{width:44px;height:44px}
.lightbox-toolbar{height:48px;padding:0 4px 0 12px}
.lightbox-bottombar{height:44px;padding:0 8px}
}

/* ── Article Images ── */
.article-body img{cursor:zoom-in;display:block;max-width:100%;height:auto;background:var(--surface-container-high);border-radius:var(--shape-m);margin:18px 0;border:1px solid var(--outline-variant)}
.img-figure{margin:18px 0;text-align:center}
.img-figure img{margin:0 auto}
.img-figure figcaption{font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:13px;color:var(--outline);line-height:1.6;margin-top:8px;padding:0 8px}
