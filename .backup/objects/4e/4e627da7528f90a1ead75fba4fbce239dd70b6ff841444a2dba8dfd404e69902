.cb-lines{flex-shrink:0;padding:19px 16px 19px 12px;text-align:right;user-select:none;-webkit-user-select:none;position:sticky;left:0;background:var(--cb-bg);z-index:1}
.cb-lines span{display:block;font-family:'JetBrains Mono','SF Mono',monospace;font-size:14px;line-height:1.65;color:var(--cb-line);font-variant-numeric:tabular-nums}
