/* ── FAB ── */
.fab{position:fixed;bottom:24px;right:24px;width:56px;height:56px;border-radius:var(--shape-l);border:none;background:var(--surface-container-high);color:var(--on-surface);cursor:pointer;z-index:250;display:flex;align-items:center;justify-content:center;box-shadow:var(--e3);transform:scale(0);opacity:0;transition:transform var(--dur-med) var(--motion-standard),opacity var(--dur-fast) var(--motion-standard),background var(--dur-fast) var(--motion-standard)}
