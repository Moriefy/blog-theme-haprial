.sv-no-results{padding:40px 12px;text-align:center;font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:13px;color:var(--outline);animation:fadeIn var(--dur-slow) var(--motion-standard) both}
.hl-match{background:var(--primary-container);color:var(--on-primary-container);border-radius:2px;padding:0 2px}

/* ── TOC Sidebar ── */
.toc{position:fixed;top:88px;right:max(calc((100vw - 720px)/2 - 230px),24px);width:190px;max-height:calc(100vh - 140px);overflow-y:auto;z-index:210;opacity:0;transform:translateX(12px);pointer-events:none;scrollbar-width:none;transition:opacity var(--dur-med) var(--motion-standard),transform var(--dur-med) var(--motion-standard)}
.toc::-webkit-scrollbar{display:none}
