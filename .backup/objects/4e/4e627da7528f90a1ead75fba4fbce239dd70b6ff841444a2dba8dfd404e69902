.fab-comment{bottom:24px;background:var(--surface-container-high);color:var(--on-surface);transition:transform var(--dur-med) var(--motion-standard),opacity var(--dur-fast) var(--motion-standard),background var(--dur-fast) var(--motion-standard),color var(--dur-fast) var(--motion-standard),bottom var(--dur-med) var(--motion-standard-decelerate)}
