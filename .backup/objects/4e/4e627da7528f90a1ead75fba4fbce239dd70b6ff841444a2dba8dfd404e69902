.toc-list{list-style:none;padding:0}
.toc-item{padding:4px 0;cursor:pointer;font-weight:400;transform-origin:left center}
.toc-item+.toc-item{margin-top:2px}.toc-item.active{transform:scale(1.04)}
.toc-link{font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:13px;color:var(--outline);line-height:1.45;display:block;transition:color 200ms}
.toc-item.active .toc-link{color:var(--primary);font-weight:600}.toc-link:hover{color:var(--on-surface)}
.toc-link.sub{padding-left:14px;font-size:12px;opacity:.6}.toc-item.active .toc-link.sub{opacity:1}

/* ── TOC Drawer (mobile) ── */
.toc-sheet{position:fixed;inset:0;z-index:220;pointer-events:none;display:flex;align-items:flex-end}
.toc-sheet.open{pointer-events:auto}
.toc-scrim{position:absolute;inset:0;background:rgba(0,0,0,.32);opacity:0;transition:opacity var(--dur-med) var(--motion-standard)}
