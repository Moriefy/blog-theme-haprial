.toc-drawer{position:relative;width:100%;max-height:60vh;background:var(--surface-container-low);border-radius:var(--shape-xl) var(--shape-xl) 0 0;padding:12px 0 28px;transform:translateY(100%);transition:transform var(--dur-med) var(--motion-standard-decelerate);display:flex;flex-direction:column}
