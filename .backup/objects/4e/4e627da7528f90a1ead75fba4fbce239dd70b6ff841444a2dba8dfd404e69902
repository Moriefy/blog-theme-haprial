.art-nav-label{font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:11px;font-weight:400;color:var(--outline);letter-spacing:.06em;margin-bottom:3px}
.art-nav-title{font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:14px;font-weight:600;color:var(--on-surface);line-height:1.45;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}

/* ── Code Blocks ── */
.code-block{border-radius:var(--shape-m);overflow:hidden;margin:18px 0;background:var(--cb-bg);border:1px solid var(--outline-variant)}
.cb-bar{display:flex;align-items:center;justify-content:space-between;padding:0 4px 0 16px;height:38px;background:var(--cb-bar-bg);border-bottom:1px solid var(--cb-bar-border)}
