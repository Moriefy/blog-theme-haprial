.cb-pre-wrap{flex:1;min-width:0}
.cb-pre-wrap pre[class*="language-"]{margin:0!important;padding:19px 20px!important;background:transparent!important;border:none!important;border-radius:0!important;font-family:'JetBrains Mono','SF Mono','Fira Code','Noto Sans SC',monospace!important;font-size:14px!important;line-height:1.65!important;white-space:pre!important;word-wrap:normal!important;overflow:visible!important}
.cb-pre-wrap code[class*="language-"]{font-family:'JetBrains Mono','SF Mono','Fira Code','Noto Sans SC',monospace!important;font-size:14px!important;line-height:1.65!important;background:none!important;padding:0!important;color:var(--cb-text)!important;white-space:pre!important;word-wrap:normal!important}

/* ── Search ── */
.search-view{position:fixed;inset:0;z-index:300;background:var(--surface);transform:translateY(-100%);transition:transform var(--dur-med) var(--motion-standard);display:flex;flex-direction:column;overscroll-behavior:contain;backface-visibility:hidden}
.search-view.open{transform:translateY(0)}
.sv-bar{height:56px;display:flex;align-items:center;padding:0 8px;gap:4px;flex-shrink:0;background:var(--surface);transition:background-color 200ms;border-bottom:1px solid var(--outline-variant)}
.sv-input{flex:1;min-width:0;height:100%;background:none;border:none;outline:none;font-family:'Noto Sans SC','PingFang SC',sans-serif;font-size:18px;font-weight:400;color:var(--on-surface);padding:0 12px;box-shadow:none;-webkit-appearance:none;appearance:none}
